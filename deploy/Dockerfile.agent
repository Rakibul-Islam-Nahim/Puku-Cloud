# Multi-stage build for the PukuCloud guest agent (Linux only).
FROM golang:1.23-alpine AS build
WORKDIR /src
COPY agent/go.mod agent/go.sum ./agent/
RUN cd agent && go mod download
COPY agent ./agent
ARG SEMVER=v0.0.0-docker
ARG COMMIT=unknown
ARG BTIME=unknown
RUN cd agent && CGO_ENABLED=0 go build \
    -ldflags "-X github.com/pukucloud/agent/internal/api.semver=${SEMVER} \
              -X github.com/pukucloud/agent/internal/api.commit=${COMMIT} \
              -X github.com/pukucloud/agent/internal/api.buildTime=${BTIME}" \
    -o /out/pukucloud-agent ./cmd/agent

FROM alpine:3.20
RUN apk add --no-cache iproute2 iptables e2fsprogs util-linux tar gzip wget firecracker || \
    apk add --no-cache iproute2 iptables e2fsprogs util-linux tar gzip wget
COPY --from=build /out/pukucloud-agent /usr/local/bin/pukucloud-agent
RUN mkdir -p /var/lib/pukucloud /var/run/pukucloud
ENV PUKUCLOUD_AGENT_LISTEN=0.0.0.0:9090
ENV PUKUCLOUD_DATA_DIR=/var/lib/pukucloud
EXPOSE 9090
ENTRYPOINT ["/usr/local/bin/pukucloud-agent"]
