#!/bin/bash
# cloud-init for pukucloud-agent nodes (AWS multi-node mode).
#
# AWS port of cloud-init/user-data-agent.sh (the canonical GCP provisioning).
# Runs the Firecracker compute plane only. No public web surface; reachable
# only from edge + db-proxy hosts over the VPC on :8081 (gated by X-Node-Token).
# Requires a *.metal instance type (bare-metal KVM).
#
# Identity comes from IMDSv2, secrets from AWS Secrets Manager (names prefixed
# "${secret_prefix}-"), artifacts from the S3 build bucket. Terraform renders:
#   region            - AWS region label
#   secret_prefix     - Secrets Manager name prefix
#   agent_binary_url  - https:// or s3:// URL of the pukucloud-agent binary
#                       (empty = s3://<bucket>/bin/pukucloud-agent, else AMI)
#   s3_bucket_name    - build/template bucket (kernels/, templates/, bin/, keys/)
#   xfs_image_size_gb - size of the XFS+reflink loopback data volume
#
# OBJECT-STORAGE CAVEAT (read before relying on this env for anything durable):
# the agent's object-store backend is GCS-only (seed-sync, user snapshot/fork
# replication, managed-DB WAL archive + failover restore, UFFD/NBD streaming all
# speak gs://). There is no S3 backend in the agent yet, so on AWS those stay
# OFF: each host cold-bakes its own template snapshots on first use (~3 s once
# per template per host, then the normal ~150 ms restore path), forks stay
# same-host, and managed databases are durable only as far as this host's data
# volume. Kernels, rootfs templates and binaries DO come from S3 (plain file
# sync below) — that part is shell, not agent code.
set -euo pipefail
exec > >(tee -a /var/log/pukucloud-cloud-init.log) 2>&1
export DEBIAN_FRONTEND=noninteractive

REGION="${region}"
SECRET_PREFIX="${secret_prefix}"
AGENT_BINARY_URL="${agent_binary_url}"
S3_BUCKET="${s3_bucket_name}"
XFS_IMAGE_SIZE_GB="${xfs_image_size_gb}"

# Wait for any concurrent apt/dpkg (cloud-init's own package_update) to release locks.
for _ in $(seq 1 120); do
  if ! fuser /var/lib/dpkg/lock-frontend /var/lib/apt/lists/lock /var/lib/dpkg/lock >/dev/null 2>&1; then
    break
  fi
  sleep 5
done

apt-get update
# Base runtime tooling + extras needed for template baking
# (debootstrap/chroot used by scripts/build-base-rootfs.sh + scripts/bake-templates.sh).
# postgresql-client: used by the NATID claim (psql) and its heartbeat timer.
# zstd is not optional: agent/internal/seed/user_template.go bakes and pulls
# custom templates with `tar --use-compress-program 'zstd -T0'`, so a host
# without the binary fails every custom-template operation at runtime.
apt-get install -y ca-certificates curl wget jq unzip squashfs-tools iproute2 iptables \
  uuid-runtime e2fsprogs sqlite3 xfsprogs debootstrap rsync coreutils postgresql-client zstd file

# AWS CLI v2 from the official installer (the apt package lags and v1 lacks the
# conditional-write flag the shared-key bootstrap below relies on).
if ! command -v aws >/dev/null 2>&1; then
  curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip
  unzip -q /tmp/awscliv2.zip -d /tmp
  /tmp/aws/install --update
  rm -rf /tmp/aws /tmp/awscliv2.zip
fi
export AWS_DEFAULT_REGION="$REGION"

# Verify KVM is available (bare-metal required).
if [ ! -e /dev/kvm ]; then
  echo "FATAL: /dev/kvm missing — agent requires a *.metal instance type." >&2
  exit 1
fi

# ── Identity (IMDSv2) ─────────────────────────────────────────────────────────
imds() {
  local tok
  tok="$(curl -sfX PUT 'http://169.254.169.254/latest/api/token' -H 'X-aws-ec2-metadata-token-ttl-seconds: 300')"
  curl -sf -H "X-aws-ec2-metadata-token: $tok" "http://169.254.169.254/latest/meta-data/$1" 2>/dev/null || true
}
INSTANCE_ID="$(imds instance-id)"
ZONE_FULL="$(imds placement/availability-zone)"
INTERNAL_IP="$(imds local-ipv4)"
: "$${INSTANCE_ID:?IMDS instance-id unavailable}"
: "$${INTERNAL_IP:?IMDS local-ipv4 unavailable}"

# ── Secrets ───────────────────────────────────────────────────────────────────
secret() {
  aws secretsmanager get-secret-value --secret-id "$1" --query SecretString --output text 2>/dev/null || true
}
NODE_TOKEN="$(secret "$${SECRET_PREFIX}-node-token")"
DATABASE_URL="$(secret "$${SECRET_PREFIX}-database-url")"
CLICKHOUSE_URL="$(secret "$${SECRET_PREFIX}-clickhouse-url")"
SUPABASE_JSON="$(secret "$${SECRET_PREFIX}-supabase")"
SUPABASE_JWKS_URL="$(printf '%s' "$SUPABASE_JSON" | jq -r '.supabase_jwks_url // ""' 2>/dev/null || true)"
: "$${NODE_TOKEN:?node-token secret is empty}"
: "$${DATABASE_URL:?database-url secret is empty (rds.tf writes it)}"

# ── Firecracker ───────────────────────────────────────────────────────────────
# v1.16.0: brings the vsock UDS path override at /snapshot/load (PR #5323)
# used for the per-sandbox readiness ping. Firecracker snapshots are
# version-bound — seeds baked on another FC version are rejected and re-baked.
install -d -m 0755 /usr/local/src/pukucloud-firecracker
if ! command -v firecracker >/dev/null 2>&1 || ! firecracker --version 2>/dev/null | grep -q '1.16.0'; then
  for i in 1 2 3 4 5; do
    wget -qO /usr/local/src/pukucloud-firecracker/firecracker-v1.16.0-x86_64.tgz \
      https://github.com/firecracker-microvm/firecracker/releases/download/v1.16.0/firecracker-v1.16.0-x86_64.tgz \
      && file /usr/local/src/pukucloud-firecracker/firecracker-v1.16.0-x86_64.tgz | grep -q gzip && break
    echo "firecracker download attempt $i failed, retrying"; sleep $((i*5))
  done
  tar -xzf /usr/local/src/pukucloud-firecracker/firecracker-v1.16.0-x86_64.tgz -C /usr/local/src/pukucloud-firecracker
  install -m 0755 /usr/local/src/pukucloud-firecracker/release-v1.16.0-x86_64/firecracker-v1.16.0-x86_64 /usr/local/bin/firecracker
  install -m 0755 /usr/local/src/pukucloud-firecracker/release-v1.16.0-x86_64/jailer-v1.16.0-x86_64 /usr/local/bin/jailer
fi

groupadd -f kvm
usermod -aG kvm ubuntu
cat > /etc/udev/rules.d/99-kvm.rules <<'KVMRULES'
KERNEL=="kvm", GROUP="kvm", MODE="0660"
KVMRULES
udevadm control --reload-rules
udevadm trigger --name-match=kvm || true

# ── Kernel knobs ──────────────────────────────────────────────────────────────
sysctl -w net.ipv4.ip_forward=1
# 2 MiB hugepages for Firecracker guest memory (PUKUCLOUD_HUGEPAGES).
#   * nr_hugepages = a BOOT-TIME RESERVATION carved out of unfragmented RAM —
#     this is what makes hugepage bakes/restores reliable on a long-lived host
#     (on-demand assembly fails with EFAULT once free RAM is fragmented).
#   * nr_overcommit_hugepages = best-effort on-demand pages beyond the pool.
# Reserve ceil(RAM_MiB / 2 * 0.30) pages, floored at 1152 (2.25 GiB) and capped
# at 8192 (16 GiB). Applied NOW, early in boot, while RAM is still contiguous.
MEMTOTAL_MIB=$(( $(awk '/MemTotal/{print $2}' /proc/meminfo) / 1024 ))
HUGEPAGE_RESERVE=$(( MEMTOTAL_MIB * 30 / 100 / 2 ))
if [ "$HUGEPAGE_RESERVE" -lt 1152 ]; then HUGEPAGE_RESERVE=1152; fi
if [ "$HUGEPAGE_RESERVE" -gt 8192 ]; then HUGEPAGE_RESERVE=8192; fi
HUGEPAGE_OVERCOMMIT=$(( MEMTOTAL_MIB / 2048 ))
cat > /etc/sysctl.d/99-pukucloud.conf <<SYSCTL
net.ipv4.ip_forward=1
vm.nr_hugepages=$${HUGEPAGE_RESERVE}
vm.nr_overcommit_hugepages=$${HUGEPAGE_OVERCOMMIT}
SYSCTL
sysctl -w vm.nr_hugepages="$HUGEPAGE_RESERVE" || true
sysctl -w vm.nr_overcommit_hugepages="$HUGEPAGE_OVERCOMMIT" || true
echo "pukucloud: hugepage reservation -> requested=$HUGEPAGE_RESERVE actual=$(awk '/HugePages_Total/{print $2}' /proc/meminfo)"

# dm_snapshot: per-sandbox CoW rootfs (no per-create file copy). nbd: the
# streamed-rootfs origin device (PUKUCLOUD_STREAM_DISK); its node pool is fixed
# at module load, so raise nbds_max here where it can still be set.
printf 'dm_snapshot\nnbd\n' > /etc/modules-load.d/pukucloud.conf
printf 'options nbd nbds_max=64\n' > /etc/modprobe.d/pukucloud-nbd.conf
modprobe dm_snapshot || true
modprobe nbd nbds_max=64 || true

# ── Swap + zswap: the reclaim substrate the memory pressure ladder needs ─────
# memory.high squeezes (agent/internal/sandbox/pressure.go) can only RECLAIM if
# anon pages have somewhere to go; pressure.go gates the squeeze rung on
# SwapTotal. zswap keeps the common case in compressed RAM.
if [ ! -f /swapfile ]; then
  fallocate -l 16G /swapfile
  chmod 600 /swapfile
  mkswap /swapfile
fi
grep -q "^/swapfile" /etc/fstab || echo "/swapfile none swap sw 0 0" >> /etc/fstab
swapon --show --noheadings | grep -q /swapfile || swapon /swapfile
modprobe zstd 2>/dev/null || true
(echo zstd > /sys/module/zswap/parameters/compressor 2>/dev/null || echo lzo > /sys/module/zswap/parameters/compressor)
echo 25 > /sys/module/zswap/parameters/max_pool_percent
echo Y > /sys/module/zswap/parameters/shrinker_enabled
echo Y > /sys/module/zswap/parameters/enabled

install -d -m 0755 /var/lib/pukucloud /var/lib/pukucloud-io /run/fcsandbox /etc/pukucloud

# ── XFS+reflink loopback at /var/lib/pukucloud ───────────────────────────────
# FICLONE (CoW) between template-snaps/*/clone.ext4 and vms/<id>/rootfs.ext4
# needs one XFS filesystem; it drops rootfs clone from ~5.5 s (copy) to ~1 ms.
# Sized by Terraform (var.agent_xfs_image_size_gb) against the root volume:
# the loopback is sparse, so an oversized image ENOSPCs mid-write instead of
# failing at create time.
if [ "$(stat -f -c %T /var/lib/pukucloud)" != "xfs" ]; then
  if [ ! -f /opt/pukucloud.img ]; then
    truncate -s "$${XFS_IMAGE_SIZE_GB}G" /opt/pukucloud.img
    mkfs.xfs -m reflink=1 -m crc=1 -q /opt/pukucloud.img
  fi
  install -d -m 0755 /mnt/pukucloud-stage
  mount -o loop /opt/pukucloud.img /mnt/pukucloud-stage
  if [ -d /var/lib/pukucloud ] && [ "$(ls -A /var/lib/pukucloud 2>/dev/null)" ]; then
    cp -a /var/lib/pukucloud/. /mnt/pukucloud-stage/ || true
  fi
  umount /mnt/pukucloud-stage
  rmdir /mnt/pukucloud-stage
  mount -o loop /opt/pukucloud.img /var/lib/pukucloud
  if ! grep -q "/opt/pukucloud.img" /etc/fstab; then
    echo "/opt/pukucloud.img /var/lib/pukucloud xfs loop,defaults 0 0" >> /etc/fstab
  fi
fi

# ── Durable data volume: customer volumes + managed-DB PGDATA ─────────────────
# The launch template attaches a second EBS volume (delete_on_termination =
# false) for /var/lib/pukucloud/volumes, mounted ON TOP of the loopback so
# volume files never eat the cache budget. It is the only thing on this host
# that is not cache. Detected as "the EBS disk that is not the root disk" (on
# Nitro/metal hosts EBS shows up as /dev/nvmeXn1, not the /dev/sdX mapping
# name). blkid guard: a disk that already carries a filesystem is NEVER
# reformatted, so re-attaching a surviving volume to a replacement instance
# brings its data back.
#
# NOTE vs GCP: an ASG cannot re-attach a stateful disk the way a GCP MIG does.
# When the ASG replaces an instance, its data volume is left behind (not
# deleted) and the replacement gets a fresh one; recovery is manual
# (aws ec2 attach-volume to the new instance, then reboot). See infra/README.md.
ROOT_DISK="$(lsblk -no PKNAME "$(findmnt -no SOURCE /)" 2>/dev/null || true)"
DATA_DEV=""
for d in $(lsblk -dn -o NAME,TYPE | awk '$2=="disk"{print $1}'); do
  [ "$d" = "$ROOT_DISK" ] && continue
  case "$d" in loop*|nbd*|dm-*) continue;; esac
  DATA_DEV="/dev/$d"; break
done
if [ -n "$DATA_DEV" ]; then
  if ! blkid "$DATA_DEV" >/dev/null 2>&1; then
    mkfs.ext4 -F -q -L pukucloud-vol "$DATA_DEV"
  fi
  install -d -m 0755 /var/lib/pukucloud/volumes
  if ! grep -q "LABEL=pukucloud-vol" /etc/fstab; then
    echo "LABEL=pukucloud-vol /var/lib/pukucloud/volumes ext4 defaults,nofail,x-systemd.requires=/var/lib/pukucloud 0 2" >> /etc/fstab
  fi
  mountpoint -q /var/lib/pukucloud/volumes || mount "$DATA_DEV" /var/lib/pukucloud/volumes
else
  echo "WARN: no data volume found — customer volumes + PGDATA will live on the loopback (lost with the instance)."
fi

install -d -m 0755 /var/lib/pukucloud/kernels /var/lib/pukucloud/templates \
  /var/lib/pukucloud/template-snaps /var/lib/pukucloud/vms /var/lib/pukucloud/snapshots
install -d -m 0700 /var/lib/pukucloud/keys

# ── Binaries + kernels + rootfs templates from S3 ─────────────────────────────
fetch() { # fetch <https-or-s3-url> <dest>
  case "$1" in
    s3://*) aws s3 cp "$1" "$2" ;;
    *)      curl -fsSL "$1" -o "$2" ;;
  esac
}
if [ -n "$AGENT_BINARY_URL" ]; then
  fetch "$AGENT_BINARY_URL" /usr/local/bin/pukucloud-agent
  chmod 0755 /usr/local/bin/pukucloud-agent
elif [ -n "$S3_BUCKET" ]; then
  aws s3 cp "s3://$S3_BUCKET/bin/pukucloud-agent" /usr/local/bin/pukucloud-agent || true
  chmod 0755 /usr/local/bin/pukucloud-agent 2>/dev/null || true
fi
if [ -n "$S3_BUCKET" ]; then
  aws s3 cp "s3://$S3_BUCKET/bin/pukucloud-init" /usr/local/bin/pukucloud-init || true
  chmod 0755 /usr/local/bin/pukucloud-init 2>/dev/null || true
  # Idempotent: unchanged objects are skipped, so a golden-AMI boot is ~metadata only.
  aws s3 sync "s3://$S3_BUCKET/kernels/"   /var/lib/pukucloud/kernels/   || true
  aws s3 sync "s3://$S3_BUCKET/templates/" /var/lib/pukucloud/templates/ || true
  # Drop stale agent-key bake markers next to a refreshed rootfs; a surviving
  # marker would make the agent skip key injection and lose SSH into guests.
  find /var/lib/pukucloud/templates/ -name '*.ext4.dkey' -delete 2>/dev/null || true
fi
[ -x /usr/local/bin/pukucloud-agent ] || echo "WARN: /usr/local/bin/pukucloud-agent missing — set agent_binary_url or publish bin/pukucloud-agent to s3://$S3_BUCKET"

# ── Fleet-shared SSH key ──────────────────────────────────────────────────────
# Every agent injects the SAME ed25519 key into guest rootfs/snapshots so a
# snapshot baked on one agent is usable by any other. The bundle lives at
# s3://$S3_BUCKET/keys/agent_keypair.tar; creation is atomic via S3 conditional
# writes (--if-none-match '*'): only the first racer wins, everyone re-downloads
# the winner. Any failure leaves the keys dir empty so the agent self-generates
# a per-host key (seeding becomes a no-op, never a correctness failure).
SHARED_KEY_OK=0
bootstrap_shared_key() {
  [ -n "$S3_BUCKET" ] || return 1
  local key="keys/agent_keypair.tar"
  local tmp; tmp="$(mktemp -d)"
  if ! aws s3 cp "s3://$S3_BUCKET/$key" "$tmp/agent_keypair.tar" 2>/dev/null; then
    ssh-keygen -t ed25519 -N '' -C 'pukucloud-agent-shared' -f "$tmp/agent_ed25519" >/dev/null 2>&1 || return 1
    tar -cf "$tmp/agent_keypair.tar" -C "$tmp" agent_ed25519 agent_ed25519.pub || return 1
    aws s3api put-object --bucket "$S3_BUCKET" --key "$key" --body "$tmp/agent_keypair.tar" --if-none-match '*' >/dev/null 2>&1 || true
    aws s3 cp "s3://$S3_BUCKET/$key" "$tmp/agent_keypair.tar" 2>/dev/null || return 1
  fi
  tar -xf "$tmp/agent_keypair.tar" -C "$tmp" || return 1
  [ -f "$tmp/agent_ed25519" ] && [ -f "$tmp/agent_ed25519.pub" ] || return 1
  local derived stored
  derived="$(ssh-keygen -y -f "$tmp/agent_ed25519" 2>/dev/null | awk '{print $1" "$2}')" || return 1
  stored="$(awk '{print $1" "$2}' "$tmp/agent_ed25519.pub")" || return 1
  [ -n "$derived" ] && [ "$derived" = "$stored" ] || return 1
  install -m 0600 "$tmp/agent_ed25519"     /var/lib/pukucloud/keys/agent_ed25519
  install -m 0644 "$tmp/agent_ed25519.pub" /var/lib/pukucloud/keys/agent_ed25519.pub
  rm -rf "$tmp"
  return 0
}
if bootstrap_shared_key; then
  SHARED_KEY_OK=1
  echo "Fleet-shared ssh key installed."
else
  echo "WARN: shared ssh key bootstrap failed; agent will self-generate (cross-host snapshot reuse disabled this boot)."
fi

# ── NATID claim ──────────────────────────────────────────────────────────────
# A unique integer per agent host that defines a non-overlapping IP namespace
# for its Firecracker VMs. Claimed from the shared Postgres under an advisory
# lock; renewed every 2 min by the heartbeat timer; stale (>30 min) claims are
# evicted by the next boot. Pool exhaustion FAILS startup rather than handing
# out a duplicate.
#
# The API creates agent_natid_claims at its own startup (api/cmd/api/natid.go).
# On a fresh stack the agent and edge ASGs boot concurrently, so create it here
# too with the identical idempotent DDL rather than racing the edge.
psql "$DATABASE_URL" -q -v ON_ERROR_STOP=1 <<'DDL' || true
CREATE TABLE IF NOT EXISTS agent_natid_claims (
    natid          INT PRIMARY KEY,
    instance_id    TEXT NOT NULL,
    region         TEXT NOT NULL DEFAULT '',
    claimed_at     TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    last_heartbeat TIMESTAMPTZ NOT NULL DEFAULT NOW()
);
CREATE UNIQUE INDEX IF NOT EXISTS agent_natid_claims_instance_idx
    ON agent_natid_claims (instance_id);
DDL

claim_natid() {
  psql "$1" -v "instance_id=$2" -v "region=$3" -t -A 2>/dev/null <<'NATID_SQL'
\set ON_ERROR_STOP on
BEGIN;
SELECT pg_advisory_xact_lock(8765432100);
DELETE FROM agent_natid_claims
  WHERE last_heartbeat < NOW() - INTERVAL '30 minutes'
    AND instance_id != :'instance_id';
UPDATE agent_natid_claims SET last_heartbeat = NOW() WHERE instance_id = :'instance_id';
INSERT INTO agent_natid_claims (natid, instance_id, region)
  SELECT n, :'instance_id', :'region'
  FROM generate_series(1, 24) AS n
  WHERE NOT EXISTS (SELECT 1 FROM agent_natid_claims WHERE natid = n)
    AND NOT EXISTS (SELECT 1 FROM agent_natid_claims WHERE instance_id = :'instance_id')
  ORDER BY n LIMIT 1;
SELECT natid FROM agent_natid_claims WHERE instance_id = :'instance_id';
COMMIT;
NATID_SQL
}

# RDS can still be finishing its first boot when the first agent comes up;
# 30 x 10 s covers that window.
NATID=""
for attempt in $(seq 1 30); do
  NATID=$(claim_natid "$DATABASE_URL" "$INSTANCE_ID" "$REGION" | grep -E '^[0-9]+$' | head -1 | tr -d '[:space:]' || true)
  if echo "$NATID" | grep -qE '^[0-9]+$'; then break; fi
  echo "NATID claim attempt $attempt failed, retrying in 10s..."
  sleep 10
done
if ! echo "$NATID" | grep -qE '^[0-9]+$'; then
  echo "ERROR: failed to claim a NATID after 30 attempts (pool exhausted or DB unreachable). Aborting."
  exit 1
fi
echo "Claimed NATID=$NATID for instance $INSTANCE_ID"
# Observability only (needs ec2:CreateTags on the instance role; best-effort).
aws ec2 create-tags --resources "$INSTANCE_ID" --tags "Key=pukucloud-natid,Value=$NATID" 2>/dev/null || true

# ── Agent environment ─────────────────────────────────────────────────────────
cat > /etc/pukucloud/env.agent <<EOF
PUKUCLOUD_DB_DRIVER=pgx
PUKUCLOUD_DB_DSN=$${DATABASE_URL}
PUKUCLOUD_NODE_TOKEN=$${NODE_TOKEN}
PUKUCLOUD_LISTEN_TCP=:8081
PUKUCLOUD_METRICS_LISTEN=:9100
PUKUCLOUD_AGENT_ID=$${INSTANCE_ID}
PUKUCLOUD_AGENT_ENDPOINT=http://$${INTERNAL_IP}:8081
PUKUCLOUD_REGION=$${REGION}
PUKUCLOUD_ZONE=$${ZONE_FULL}
PUKUCLOUD_INTERNAL_IP=$${INTERNAL_IP}
# Object storage is GCS-only in the agent (see the header of this file). Both
# stay EMPTY on AWS: seed-sync, snapshot/fork replication, managed-DB WAL
# archive + failover restore and UFFD/NBD streaming are all disabled until an
# S3 backend lands. Do NOT point these at an S3 bucket — the agent would try
# gs:// semantics against it.
PUKUCLOUD_GCS_BUCKET=
PUKUCLOUD_SNAPSHOT_BUCKET=
# Streaming restore/disk need object-store Range GETs => off without a bucket.
PUKUCLOUD_STREAM_RESTORE=0
PUKUCLOUD_STREAM_DISK=0
# 2 MiB hugetlbfs guest memory on cold boots (restore goes through the local
# UFFD path, no object store involved). Requires the sysctl reservation above.
PUKUCLOUD_HUGEPAGES=1
# NATID is a MODE FLAG (the agent only tests == "1"); the claimed slot is kept
# in a separate observability-only variable.
PUKUCLOUD_NATID=1
PUKUCLOUD_NATID_SLOT=$${NATID}
PUKUCLOUD_NATID_POOL_SIZE=24
PUKUCLOUD_SHARED_KEY=$${SHARED_KEY_OK}
SUPABASE_JWKS_URL=$${SUPABASE_JWKS_URL}
CLICKHOUSE_URL=$${CLICKHOUSE_URL}
PUKUCLOUD_CLICKHOUSE_URL=$${CLICKHOUSE_URL}
# Squeezable class: cold-boots with 4 KiB pages so cgroup memory.high can
# reclaim. The postgres family is deliberately absent (guaranteed class).
PUKUCLOUD_NOHUGE_TEMPLATES=base,code-interpreter,agent
# Managed-database transparent auto-suspend after this many idle seconds
# (pg_stat_activity based); db-proxy wakes it on the next connection. 0 = off.
PUKUCLOUD_DB_IDLE_AFTER_SECONDS=900
# Vsock exec fast-path; SSH stays the fallback. Off until the guest daemon is
# baked into your snapshots.
PUKUCLOUD_VSOCK_EXEC=0
EOF
chmod 0600 /etc/pukucloud/env.agent

# seed-sync is intentionally NOT run here: it pulls from PUKUCLOUD_GCS_BUCKET,
# which is empty on AWS. Templates are cold-baked on first spawn per host.

cat > /etc/systemd/system/pukucloud-agent.service <<'UNIT'
[Unit]
Description=PukuCloud Firecracker agent (multi-node)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/pukucloud/env.agent
ExecStart=/usr/local/bin/pukucloud-agent \
  -socket /run/fcsandbox/agent.sock \
  -data-dir /var/lib/pukucloud \
  -db /var/lib/pukucloud/pukucloud.db \
  -metrics-listen :9100
Restart=always
RestartSec=3
LimitNOFILE=1048576
# SIGTERM only the agent PID: the default control-group mode would also
# SIGTERM every firecracker child, killing the FC API socket the agent needs
# to Pause+Snapshot for hibernation. KillMode=mixed lets the agent orchestrate
# FC shutdown itself; systemd still SIGKILLs the cgroup on budget overrun.
KillMode=mixed
# Delegate the cgroup subtree so the agent can create per-VM child cgroups
# (cpu.weight tiers, active-CPU meter, memory.high for the pressure ladder).
Delegate=yes
# Hibernate budget (120 s default) + 60 s slack. Must exceed
# PUKUCLOUD_HIBERNATE_BUDGET_SECONDS or systemd preempts the graceful stop.
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now pukucloud-agent || true

# ── NATID heartbeat timer ────────────────────────────────────────────────────
cat > /usr/local/bin/pukucloud-natid-heartbeat.sh <<'HEARTBEAT'
#!/bin/bash
set -euo pipefail
AGENT_ID=$(grep '^PUKUCLOUD_AGENT_ID=' /etc/pukucloud/env.agent | cut -d= -f2-)
DB_DSN=$(grep '^PUKUCLOUD_DB_DSN=' /etc/pukucloud/env.agent | cut -d= -f2-)
psql "$DB_DSN" \
  -v "agent_id=$AGENT_ID" \
  -c "UPDATE agent_natid_claims SET last_heartbeat = NOW() WHERE instance_id = :'agent_id'" \
  -q 2>/dev/null || true
HEARTBEAT
chmod 0755 /usr/local/bin/pukucloud-natid-heartbeat.sh

cat > /etc/systemd/system/pukucloud-natid-heartbeat.service <<'HBUNIT'
[Unit]
Description=PukuCloud NATID claim heartbeat
After=network-online.target pukucloud-agent.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/pukucloud-natid-heartbeat.sh
HBUNIT

cat > /etc/systemd/system/pukucloud-natid-heartbeat.timer <<'HBTIMER'
[Unit]
Description=PukuCloud NATID heartbeat every 2 minutes
Requires=pukucloud-natid-heartbeat.service

[Timer]
OnBootSec=2min
OnUnitActiveSec=2min
AccuracySec=30s

[Install]
WantedBy=timers.target
HBTIMER

systemctl daemon-reload
systemctl enable --now pukucloud-natid-heartbeat.timer || true

echo "agent cloud-init done at $(date -u)"
