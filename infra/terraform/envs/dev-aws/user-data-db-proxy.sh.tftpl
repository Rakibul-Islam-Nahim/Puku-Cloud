#!/bin/bash
# cloud-init for the pukucloud db-proxy node (AWS).
#
# AWS port of cloud-init/user-data-db-proxy.sh. Runs the TLS SNI postgres
# proxy: listens on :5432, routes by the sandbox ID in the SNI hostname
# (*.db.<zone> → that database's Postgres on the owning agent, over :8081).
#
# Secrets come from AWS Secrets Manager (names prefixed "${secret_prefix}-").
# Terraform renders:
#   region              - AWS region label
#   secret_prefix       - Secrets Manager name prefix
#   db_proxy_binary_url - https:// or s3:// URL of pukucloud-db-proxy
#   sni_suffix          - SNI suffix, e.g. .db.example.com (REQUIRED)
#   acme_email          - Let's Encrypt account contact (REQUIRED)
set -euo pipefail
exec > >(tee -a /var/log/pukucloud-db-proxy-cloud-init.log) 2>&1
export DEBIAN_FRONTEND=noninteractive

REGION="${region}"
SECRET_PREFIX="${secret_prefix}"
BINARY_URL="${db_proxy_binary_url}"
SNI_SUFFIX="${sni_suffix}"
ACME_EMAIL="${acme_email}"

for _ in $(seq 1 120); do
  if ! fuser /var/lib/dpkg/lock-frontend /var/lib/apt/lists/lock /var/lib/dpkg/lock >/dev/null 2>&1; then
    break
  fi
  sleep 5
done

apt-get update
apt-get install -y ca-certificates curl wget jq unzip certbot python3-certbot-dns-cloudflare

if ! command -v aws >/dev/null 2>&1; then
  curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip
  unzip -q /tmp/awscliv2.zip -d /tmp
  /tmp/aws/install --update
  rm -rf /tmp/aws /tmp/awscliv2.zip
fi
export AWS_DEFAULT_REGION="$REGION"

secret() {
  aws secretsmanager get-secret-value --secret-id "$1" --query SecretString --output text 2>/dev/null || true
}
NODE_TOKEN="$(secret "$${SECRET_PREFIX}-node-token")"
DATABASE_URL="$(secret "$${SECRET_PREFIX}-database-url")"
CLOUDFLARE_API_TOKEN="$(secret "$${SECRET_PREFIX}-cloudflare-api-token")"
: "$${NODE_TOKEN:?node-token secret is empty}"
: "$${DATABASE_URL:?database-url secret is empty}"
: "$${CLOUDFLARE_API_TOKEN:?cloudflare-api-token secret is empty}"

# No defaults for these two: a default SNI suffix would request a certificate
# for someone else's domain; a default ACME email would register the account
# (and its expiry warnings) to someone else.
: "$${SNI_SUFFIX:?sni_suffix is required (e.g. .db.example.com)}"
: "$${ACME_EMAIL:?acme_email is required}"
DOMAIN="$${SNI_SUFFIX#.}"   # strip leading dot → db.example.com
CERT_DIR="/etc/letsencrypt/live/$${DOMAIN}"

# ── Cloudflare credentials for DNS-01 ─────────────────────────────────────────
CF_CREDS=/etc/cloudflare.ini
printf 'dns_cloudflare_api_token = %s\n' "$CLOUDFLARE_API_TOKEN" > "$CF_CREDS"
chmod 600 "$CF_CREDS"

# ── Wildcard cert ─────────────────────────────────────────────────────────────
if [ ! -f "$${CERT_DIR}/fullchain.pem" ]; then
  certbot certonly \
    --non-interactive \
    --agree-tos \
    --email "$ACME_EMAIL" \
    --dns-cloudflare \
    --dns-cloudflare-credentials "$CF_CREDS" \
    --dns-cloudflare-propagation-seconds 30 \
    -d "$${DOMAIN}" \
    -d "*.$${DOMAIN}"
fi

# Renewal: reload the proxy so it picks up the new chain.
HOOK=/etc/letsencrypt/renewal-hooks/deploy/db-proxy-reload.sh
cat > "$HOOK" <<'HOOK'
#!/bin/bash
systemctl kill --signal=SIGHUP pukucloud-db-proxy.service || true
HOOK
chmod +x "$HOOK"
(crontab -l 2>/dev/null; echo "0 3 * * * certbot renew --quiet") | crontab -

# ── Binary ────────────────────────────────────────────────────────────────────
BINARY=/usr/local/bin/pukucloud-db-proxy
if [ -n "$BINARY_URL" ]; then
  case "$BINARY_URL" in
    s3://*) aws s3 cp "$BINARY_URL" "$BINARY" ;;
    *)      curl -fsSL "$BINARY_URL" -o "$BINARY" ;;
  esac
  chmod +x "$BINARY"
fi
[ -x "$BINARY" ] || echo "WARN: $BINARY missing — set db_proxy_binary_url or bake it into the AMI"

# ── Environment ───────────────────────────────────────────────────────────────
ENV_FILE=/etc/pukucloud-db-proxy.env
cat > "$ENV_FILE" <<EOF
PUKUCLOUD_DB_DSN=$${DATABASE_URL}
PUKUCLOUD_NODE_TOKEN=$${NODE_TOKEN}
PUKUCLOUD_CERT_DIR=$${CERT_DIR}
PUKUCLOUD_LISTEN_ADDR=:5432
PUKUCLOUD_SNI_SUFFIX=$${SNI_SUFFIX}
PUKUCLOUD_METRICS_ADDR=:5433
EOF
chmod 600 "$ENV_FILE"

cat > /etc/systemd/system/pukucloud-db-proxy.service <<SERVICE
[Unit]
Description=PukuCloud DB Proxy (postgres:// SNI router)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
EnvironmentFile=$${ENV_FILE}
ExecStart=$${BINARY}
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/etc/letsencrypt
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pukucloud-db-proxy

[Install]
WantedBy=multi-user.target
SERVICE

systemctl daemon-reload
systemctl enable pukucloud-db-proxy
systemctl start pukucloud-db-proxy || true

echo "DB Proxy cloud-init complete. Listening on :5432."
