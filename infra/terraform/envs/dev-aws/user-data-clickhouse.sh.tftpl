#!/bin/bash
# cloud-init for the pukucloud ClickHouse node (AWS).
#
# AWS port of cloud-init/user-data-clickhouse.sh. Mounts the dedicated EBS data
# volume at /var/lib/clickhouse, installs Docker CE, runs the pinned official
# ClickHouse image on the host network, and applies the pukucloud schema from
# S3. Idempotent: safe to re-run on reboot.
#
# Terraform renders:
#   region              - AWS region label
#   clickhouse_password - admin password for the `default` user
#   schema_s3_url       - s3://bucket/clickhouse/schema.sql
#   memory_limit        - docker --memory cap (e.g. 12g)
#
# Listens on 8123 (HTTP) / 9000 (native) on the VPC only; the security group
# restricts sources to the edge + agent groups. No public IP on this instance.
set -euo pipefail
LOG=/var/log/pukucloud-clickhouse-bootstrap.log
exec > >(tee -a "$LOG") 2>&1
echo "[$(date -Is)] clickhouse bootstrap starting"
export DEBIAN_FRONTEND=noninteractive

REGION="${region}"
CH_PASSWORD="${clickhouse_password}"
SCHEMA_URL="${schema_s3_url}"
MEMORY_LIMIT="${memory_limit}"

for _ in $(seq 1 120); do
  if ! fuser /var/lib/dpkg/lock-frontend /var/lib/apt/lists/lock /var/lib/dpkg/lock >/dev/null 2>&1; then
    break
  fi
  sleep 5
done

# 1. Data volume at /var/lib/clickhouse ---------------------------------------
# The dedicated EBS volume (clickhouse.tf, delete_on_termination = false) is
# "the disk that is not the root disk". blkid guard: an existing filesystem is
# never reformatted, so a re-attached volume keeps its history.
MNT="/var/lib/clickhouse"
mkdir -p "$MNT"
ROOT_DISK="$(lsblk -no PKNAME "$(findmnt -no SOURCE /)" 2>/dev/null || true)"
DATA_DEV=""
for d in $(lsblk -dn -o NAME,TYPE | awk '$2=="disk"{print $1}'); do
  [ "$d" = "$ROOT_DISK" ] && continue
  case "$d" in loop*|nbd*|dm-*) continue;; esac
  DATA_DEV="/dev/$d"; break
done
if [ -n "$DATA_DEV" ]; then
  if ! blkid "$DATA_DEV" >/dev/null 2>&1; then
    echo "formatting fresh data volume $DATA_DEV as ext4"
    mkfs.ext4 -F -q -L clickhouse-data "$DATA_DEV"
  fi
  mountpoint -q "$MNT" || mount -o defaults,noatime "$DATA_DEV" "$MNT"
  grep -q "LABEL=clickhouse-data" /etc/fstab || echo "LABEL=clickhouse-data $MNT ext4 defaults,noatime,nofail 0 2" >> /etc/fstab
else
  echo "WARN: no data volume found — using the root volume for $MNT"
fi
chown -R 101:101 "$MNT"  # clickhouse user uid in the official image

# 2. Docker CE + AWS CLI -------------------------------------------------------
apt-get update -y
apt-get install -y ca-certificates curl gnupg jq unzip
if ! command -v docker >/dev/null 2>&1; then
  install -m 0755 -d /etc/apt/keyrings
  curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
  chmod a+r /etc/apt/keyrings/docker.gpg
  echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" > /etc/apt/sources.list.d/docker.list
  apt-get update -y
  apt-get install -y docker-ce docker-ce-cli containerd.io
  systemctl enable --now docker
fi
if ! command -v aws >/dev/null 2>&1; then
  curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip
  unzip -q /tmp/awscliv2.zip -d /tmp
  /tmp/aws/install --update
  rm -rf /tmp/aws /tmp/awscliv2.zip
fi
export AWS_DEFAULT_REGION="$REGION"

if [ -z "$CH_PASSWORD" ]; then
  echo "FATAL: clickhouse_password is empty" >&2
  exit 1
fi

# 3. Run/refresh the container (pinned; the GCP env runs the same tag) --------
CONTAINER="pukucloud-clickhouse"
IMAGE="clickhouse/clickhouse-server:24.8"
docker pull "$IMAGE" || true
if docker inspect -f '{{.Config.Image}}' "$CONTAINER" 2>/dev/null | grep -qv "^$IMAGE\$"; then
  docker rm -f "$CONTAINER" || true
fi
if ! docker ps --format '{{.Names}}' | grep -q "^$${CONTAINER}\$"; then
  docker rm -f "$CONTAINER" 2>/dev/null || true
  docker run -d --restart=unless-stopped \
    --name "$CONTAINER" \
    --network host \
    --ulimit nofile=262144:262144 \
    --memory="$MEMORY_LIMIT" --memory-swap="$MEMORY_LIMIT" \
    -v /var/lib/clickhouse:/var/lib/clickhouse \
    -e CLICKHOUSE_USER=default \
    -e CLICKHOUSE_PASSWORD="$CH_PASSWORD" \
    -e CLICKHOUSE_DB=pukucloud \
    -e CLICKHOUSE_DEFAULT_ACCESS_MANAGEMENT=1 \
    "$IMAGE"
fi

# 4. Wait for readiness --------------------------------------------------------
echo "waiting for clickhouse to accept connections..."
for _ in $(seq 1 60); do
  if curl -fsS "http://localhost:8123/ping" >/dev/null 2>&1; then
    echo "clickhouse healthy"
    break
  fi
  sleep 2
done

# 5. Apply schema.sql ----------------------------------------------------------
if [ -n "$SCHEMA_URL" ]; then
  echo "fetching schema from $SCHEMA_URL"
  SCHEMA=""
  case "$SCHEMA_URL" in
    s3://*) SCHEMA="$(aws s3 cp "$SCHEMA_URL" - 2>/dev/null || true)" ;;
    *)      SCHEMA="$(curl -fsS "$SCHEMA_URL" || true)" ;;
  esac
  if [ -n "$SCHEMA" ]; then
    # ClickHouse HTTP rejects multi-statement bodies; use clickhouse-client in
    # the container, which handles ; splits + DDL.
    printf '%s' "$SCHEMA" | docker exec -i "$CONTAINER" \
      clickhouse-client --user default --password "$CH_PASSWORD" --database pukucloud --multiquery \
      || echo "WARN: schema apply returned non-zero"
  else
    echo "WARN: schema fetch returned empty"
  fi
else
  echo "no schema_s3_url — skipping schema bootstrap"
fi

echo "[$(date -Is)] clickhouse bootstrap complete"
touch /var/log/pukucloud-clickhouse-bootstrap.done
